lifegrapher/
├── .github/                      # GitHub konfigürasyonları
├── public/                       # Statik dosyalar (logo, ikonlar vb.)
├── src/
│   ├── config/                   # Genel sistem konfigürasyonları ve sabitler
│   │   └── constants.ts          # Sistem ayarları (Lokasyon, Dil, Saat Dilimi vb.)
│   ├── app/                      # Uygulama sayfaları ve yönlendirmeler (App Router)
│   │   ├── (auth)/               # Kimlik doğrulama sayfaları
│   │   │   ├── login/
│   │   │   └── register/
│   │   ├── dashboard/            # Ana Takip Paneli
│   │   ├── nutrition/            # Kalori ve Yemek Takibi
│   │   ├── sleep/                # Uyku Takibi
│   │   ├── layout.tsx
│   │   └── page.tsx
│   ├── components/               # Tekrar kullanılabilir arayüz bileşenleri (UI)
│   │   ├── ui/                   # Butonlar, inputlar, kartlar
│   │   ├── forms/                # Yemek ve Uyku ekleme formları
│   │   └── charts/               # Kalori/Uyku günlük ve haftalık grafikler
│   ├── lib/                      # Veritabanı ve harici servis bağlantıları
│   │   ├── db.ts                 # Veritabanı bağlantı istemcisi (Prisma/Supabase vb.)
│   │   └── location.ts           # Konum (Location) servisleri ve koordinat yardımcıları
│   ├── models/                   # Veritabanı veri modelleri / tipleri
│   ├── services/                 # İş mantığı ve API çağrıları
│   │   ├── nutritionService.ts   # Yemek/gıda API entegrasyonu
│   │   └── sleepService.ts       # Uyku süre ve kalite hesaplamaları
│   └── types/                    # TypeScript tip tanımlamaları
│       ├── user.ts
│       ├── nutrition.ts
│       └── sleep.ts
├── .env.example                  # Çevre değişkenleri örneği (DB URL, Location API vb.)
├── schema.prisma                 # Veritabanı Şeması (Database Schema)
├── README.md                     # Proje açıklaması ve kurulum adımları
└── package.json                  # Proje bağımlılıkları ve komutlar

